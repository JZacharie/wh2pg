# PostgreSQL Configuration
# URL complète de connexion (alternative à DB_HOST, DB_PORT, etc.)
DATABASE_URL=postgresql://webhook_user:secure_password@localhost:5432/webhooks

# Paramètres PostgreSQL individuels
DB_HOST=localhost
DB_PORT=5432
DB_NAME=webhooks
DB_USER=webhook_user
DB_PASSWORD=secure_password

# Pool de connexions (optionnel, défaut: 10)
DB_POOL_SIZE=10

# Mode SSL (disable, allow, prefer, require, verify-ca, verify-full)
DB_SSL_MODE=require

# Serveur HTTP
# Adresse d'écoute (0.0.0.0 pour écouter sur toutes les interfaces)
SERVER_HOST=0.0.0.0

# Port d'écoute
SERVER_PORT=8080

# Nombre de workers (défaut: nombre de CPU)
WORKERS=2

# Logging
# Niveau de log (trace, debug, info, warn, error)
LOG_LEVEL=info

# Format de log (json, pretty)
LOG_FORMAT=json

# Sécurité
# Secret pour validation HMAC des webhooks (optionnel)
# Si défini, les webhooks doivent inclure un header X-Webhook-Signature
WEBHOOK_SECRET=your-secret-key-change-this

# Taille maximale du payload en bytes (défaut: 1MB)
MAX_PAYLOAD_SIZE=1048576

# Monitoring
# Activer les métriques Prometheus
ENABLE_METRICS=true

# Port pour les métriques (si différent du port principal)
METRICS_PORT=9090

# Performance
# Timeout pour les requêtes DB en secondes
DB_TIMEOUT=30

# Timeout pour les requêtes HTTP en secondes
REQUEST_TIMEOUT=60

# Nombre maximum de connexions simultanées
MAX_CONNECTIONS=1000

# Développement
# Mode debug (active les logs détaillés)
DEBUG=false

# Désactiver la validation HMAC en développement
SKIP_SIGNATURE_VALIDATION=false
